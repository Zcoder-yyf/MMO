# Normalize text across Windows and macOS.
* text=auto

# Unity binary terrain data.
Assets/EnvRes/TerrainDatas/*.asset filter=lfs diff=lfs merge=lfs -text
Assets/EnvRes/Settings/Village_Terrain.asset filter=lfs diff=lfs merge=lfs -text

# Binary source assets and runtime libraries.
